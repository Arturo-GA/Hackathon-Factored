# Copiar a .env (no se versiona) y completar.
# Bucket S3 entregado por los organizadores (las credenciales van en `aws configure --profile factored`, nunca aquí)
S3_BUCKET=s3://<bucket-del-hackathon>
AWS_PROFILE=factored
# Proyecto de Google Cloud donde se publican bronze/silver/gold
GCP_PROJECT=hackathon-datos-factored
# Opcionales
DUCKDB_MEMORY=3GB
DUCKDB_THREADS=6
AGENT_COST_PER_MINUTE_USD=0.15
